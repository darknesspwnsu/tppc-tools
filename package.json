{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-route-aliases.ts && next build",
    "start": "next start",
    "sync:gold-data": "node scripts/sync-gold-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ci",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:parity": "playwright test tests/parity",
    "test:parity:native": "PARITY_TARGET=native playwright test tests/parity",
    "test:parity:basepath": "NEXT_PUBLIC_BASE_PATH=/tppc-tools PARITY_BASE_PATH=/tppc-tools PARITY_TARGET=native playwright test tests/parity",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run test:parity && NEXT_PUBLIC_BASE_PATH=/tppc-tools npm run build",
    "capture:parity-fixtures": "tsx scripts/capture-parity-fixtures.ts",
    "capture:baseline-fixtures": "npm run capture:parity-fixtures"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jasmine": "^4.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
